# ── GitHub auth ───────────────────────────────────────────────────────────────
# Use a GitHub App (recommended) or a personal token. Do not commit real values.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./your-app.pem
# private key inline alternative (use \n for newlines)
GITHUB_APP_PRIVATE_KEY=

# ── Repositories ──────────────────────────────────────────────────────────────
# polling mode: owner/repo[,owner/repo2]. Leave empty for webhook-only.
GITHUB_REPO=owner/repo
# repos the bot must never review
IGNORE_REPOS=

# ── Bot behaviour ─────────────────────────────────────────────────────────────
# your GitHub App's username, used to parse @handle commands
BOT_HANDLE=ekravo-review
AUTO_APPROVE=false
# Merge a PR automatically only when the review approves it (zero findings)
# and GitHub reports the exact commit as mergeable and clean.
AUTO_MERGE=false
# merge | squash | rebase
AUTO_MERGE_METHOD=merge
SKIP_DRAFT_PRS=true
RECHECK_UPDATED_PRS=true
POLL_INTERVAL=300s
# set this to enable webhook mode; generate with: openssl rand -hex 32
WEBHOOK_SECRET=
WEBHOOK_PORT=8090
# HTTP listen address for webhook + dashboard + health + metrics
ADDR=:8090
WORKERS=4
QUEUE_SIZE=100
IGNORE_FILE_PATTERNS=*.lock,package-lock.json,yarn.lock,pnpm-lock.yaml,*.min.js,*.min.css,*.map,dist/*,build/*,.next/*,__pycache__/*,vendor/*
MAX_FILES_IN_DIFF=100
MAX_LINES_PER_FILE=2000

# ── Language model ────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Ekravo is the default.
LLM_BASE_URL=https://ekravo.com/v1
LLM_API_KEY=
# primary first, then automatic fallbacks
LLM_MODELS=deepseek-api/deepseek-flash,deepseek/deepseek-v4-flash,openrouter/free
LLM_TIMEOUT=180s
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
# none | minimal | low | medium | high | xhigh | max | auto
# none is strongly recommended for JSON reviews: reasoning tokens can exhaust
# max_tokens and truncate the JSON object.
LLM_REASONING_EFFORT=none
# characters of diff per model call
LLM_CHUNK_CHARS=120000
MAX_FINDINGS=25

# ── Repository context ───────────────────────────────────────────────────────
# off   = diff only (default, safe rollout)
# shadow = fetch, index, and log, but do not send context to the model
# on    = send validated reference snippets with each section
CONTEXT_MODE=off
# auto | tarball | git | api
CONTEXT_FETCH=auto
CONTEXT_CACHE_DIR=.ekravo-context
CONTEXT_MAX_CHARS=10000
CONTEXT_MAX_TOTAL_CHARS=30000
CONTEXT_MAX_FILES=8
CONTEXT_MAX_FILE_KB=512
CONTEXT_MAX_REPO_MB=200
CONTEXT_CACHE_ROWS=200000
CONTEXT_RATIO_MAX=0.35
CONTEXT_MIN_DIFF_CHARS=400
CONTEXT_TIMEOUT=20s
# 0 = min(NumCPU, 8)
CONTEXT_PARSE_WORKERS=0
# empty = all registered grammars; comma list to restrict
CONTEXT_LANGS=
CONTEXT_LEARNINGS=true
CONTEXT_SIMHASH=true

# ── Web evidence check ───────────────────────────────────────────────────────
# Ask Ekravo /v1/web to verify externally checkable claims (API existence,
# deprecation, CVEs) before posting critical/high findings. Local logic bugs are
# never sent. Requires web search to be enabled on the API key.
WEB_RESEARCH=true
WEB_RESEARCH_MAX_QUERIES=3
WEB_RESEARCH_TIMEOUT=15s
WEB_RESEARCH_RESULTS=4

# ── Embedded dashboard ───────────────────────────────────────────────────────
# Served at / by the same binary, in both webhook and polling modes.
DASHBOARD_ENABLED=true
# Leave empty for localhost-only use. Set a long random string to require a login.
# Generate with: openssl rand -hex 32
DASHBOARD_TOKEN=

# ── Storage and logging ───────────────────────────────────────────────────────
DB_PATH=ekravo-review.db
# legacy Python state file, used by: ekravo-review -migrate
STATE_FILE=.processed_prs.json
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── Optional ──────────────────────────────────────────────────────────────────
# shown in review footers
REPO_URL=https://github.com/EOSKILLZ/Ekravo-review
# GitHub Enterprise
GITHUB_API_URL=https://api.github.com
